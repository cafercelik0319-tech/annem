                    </div>

                    <!-- Etiket Yazısı -->
                    <span class="relative z-20 mt-1 px-2.5 py-0.5 bg-white/95 rounded-full text-[11px] sm:text-xs font-medium text-rose-800 shadow-sm border border-rose-100 whitespace-nowrap">
                        Sana Bir Notum Var ✨
                    </span>
                </div>
            </button>

        </div>
    </main>

    <!-- Alt Bilgi / İpucu -->
    <footer class="relative z-10 text-center mb-2">
        <button id="openNoteTextBtn" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white/80 hover:bg-white text-rose-700 text-xs sm:text-sm font-medium shadow-sm hover:shadow transition-all border border-rose-200/80 backdrop-blur-sm">
            <span>💌</span>
            <span>Notu Okumak İçin Dokun</span>
        </button>
    </footer>

    <!-- DOĞUM GÜNÜ MEKTUBU MODALI -->
    <div id="letterModal" class="modal-backdrop fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 bg-rose-950/45 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="letterTitle">
        
        <!-- Mektup Kartı -->
        <div class="modal-card letter-paper relative w-full max-w-lg max-h-[88vh] flex flex-col rounded-3xl p-6 sm:p-10 overflow-hidden">
            
            <!-- Üst Dekoratif Çiçek Köşesi & Kapatma Butonu -->
            <div class="flex items-center justify-between border-b border-rose-200/70 pb-4 mb-4">
                <div class="flex items-center gap-2 text-rose-500">
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                    </svg>
                    <span class="text-xs uppercase tracking-widest font-medium text-rose-400">Doğum Günü Mektubu</span>
                </div>
                
                <button id="closeModalBtn" aria-label="Mektubu kapat" class="w-9 h-9 rounded-full bg-rose-100/80 hover:bg-rose-200 text-rose-700 flex items-center justify-center transition-colors focus:outline-none">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>

            <!-- Mektup İçeriği (Kaydırılabilir) -->
            <div class="custom-scroll overflow-y-auto pr-1 space-y-4 text-rose-950">
                <h2 id="letterTitle" class="font-script text-4xl sm:text-5xl text-rose-700">
                    Canım Annem,
                </h2>

                <div class="font-serif-elegant text-lg sm:text-xl leading-relaxed space-y-4 text-stone-800">
                    <p>
                        Doğum günün kutlu olsun benim güzel annem... Hayatımdaki en değerli hazinem, ilk öğretmenim, sığınağım ve her anımda yanımda hissettiğim en büyük gücüm sensin.
                    </p>
                    <p>
                        Gülüşünle evimize güneş gibi doğduğun, şefkatinle her zorluğu kolaylaştırdığın ve koşulsuz sevginle beni bugünkü ben yaptığın için sana ne kadar teşekkür etsem az. Senin evladın olmak bu hayattaki en büyük şansım.
                    </p>
                    <p>
                        Yeni yaşında yüzünden o sıcacık gülümseme, kalbinden huzur, ömründen sağlık hiç eksik olmasın. Birlikte nice güzel, mutlu ve sağlıklı yıllarımız olsun. İyi ki varsın, iyi ki benim annemsin!
                    </p>
                </div>

                <!-- İmza Bölümü -->
                <div class="pt-4 mt-6 border-t border-rose-200/60 flex flex-col items-end text-right">
                    <span class="font-serif-elegant italic text-base sm:text-lg text-rose-700">
                        Seni Çok Seven Oğlun
                    </span>
                    <span class="font-script text-3xl sm:text-4xl text-rose-600 mt-1">
                        Cafer
                    </span>
                </div>
            </div>

            <!-- Alt Kapatma / Çiçeklere Dön Butonu -->
            <div class="mt-6 pt-3 flex justify-center">
                <button id="returnBouquetBtn" class="px-6 py-2.5 rounded-full bg-gradient-to-r from-rose-500 to-rose-600 hover:from-rose-600 hover:to-rose-700 text-white text-sm font-medium shadow-md hover:shadow-lg transition-all transform active:scale-95">
                    💐 Bukete Geri Dön
                </button>
            </div>
        </div>
    </div>

    <!-- JavaScript: Zarf Etkileşimi, Konfeti/Taç Yaprak Animasyonu -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const envelopeBtn = document.getElementById('envelopeBtn');
            const openNoteTextBtn = document.getElementById('openNoteTextBtn');
            const letterModal = document.getElementById('letterModal');
            const closeModalBtn = document.getElementById('closeModalBtn');
            const returnBouquetBtn = document.getElementById('returnBouquetBtn');

            // Mektubu Açma Fonksiyonu
            function openLetter() {
                // Önce zarf kapağını açma animasyonunu tetikle
                envelopeBtn.classList.add('envelope-opened');
                
                // Kısa bir gecikmeyle mektup modalını zarifçe ekrana getir
                setTimeout(() => {
                    letterModal.classList.add('active');
                    burstPetals(); // Mektup açılırken ekstra yaprak/parıltı şöleni
                }, 320);
            }

            // Mektubu Kapatma Fonksiyonu
            function closeLetter() {
                letterModal.classList.remove('active');
                setTimeout(() => {
                    envelopeBtn.classList.remove('envelope-opened');
                }, 300);
            }

            // Olay Dinleyicileri (Hem tıklama hem dokunma uyumlu)
            envelopeBtn.addEventListener('click', openLetter);
            openNoteTextBtn.addEventListener('click', openLetter);
            closeModalBtn.addEventListener('click', closeLetter);
            returnBouquetBtn.addEventListener('click', closeLetter);

            // Modal dışındaki karanlık alana tıklayınca kapatma
            letterModal.addEventListener('click', (e) => {
                if (e.target === letterModal) {
                    closeLetter();
                }
            });

            // ESC tuşu ile kapatma
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && letterModal.classList.contains('active')) {
                    closeLetter();
                }
            });

            // --- ARKA PLAN UÇUŞAN ÇİÇEK TAÇ YAPRAKLARI VE PARILTILAR ---
            const canvas = document.getElementById('petalsCanvas');
            const ctx = canvas.getContext('2d');
            let width, height;
            let particles = [];

            function resizeCanvas() {
                width = canvas.width = window.innerWidth;
                height = canvas.height = window.innerHeight;
            }
            window.addEventListener('resize', resizeCanvas);
            resizeCanvas();

            const petalColors = [
                'rgba(251, 113, 133, 0.45)', // Gül kurusu pembe
                'rgba(253, 164, 175, 0.55)', // Açık pastel pembe
                'rgba(255, 228, 230, 0.75)', // Beyazımsı pembe
                'rgba(244, 63, 94, 0.30)',   // Canlı gül tonu
                'rgba(253, 224, 71, 0.45)'   // Altın parıltı
            ];

            class Particle {
                constructor(isBurst = false) {
                    this.reset(isBurst);
                }

                reset(isBurst = false) {
                    this.isSparkle = Math.random() > 0.72;
                    if (isBurst) {
                        this.x = width / 2 + (Math.random() - 0.5) * 120;
                        this.y = height / 2 + (Math.random() - 0.5) * 120;
                        this.vx = (Math.random() - 0.5) * 6;
                        this.vy = (Math.random() - 0.7) * 6;
                    } else {
                        this.x = Math.random() * width;
                        this.y = Math.random() * height - height;
                        this.vx = (Math.random() - 0.5) * 1.2;
                        this.vy = 0.6 + Math.random() * 1.3;
                    }
                    this.size = this.isSparkle ? (1.5 + Math.random() * 2.5) : (6 + Math.random() * 8);
                    this.color = petalColors[Math.floor(Math.random() * petalColors.length)];
                    this.angle = Math.random() * Math.PI * 2;
                    this.spin = (Math.random() - 0.5) * 0.04;
                    this.swaySpeed = 0.01 + Math.random() * 0.02;
                    this.swayOffset = Math.random() * Math.PI * 2;
                    this.isBurst = isBurst;
                    this.life = 1.0;
                }

                update() {
                    this.x += this.vx + Math.sin(this.swayOffset) * 0.6;
                    this.y += this.vy;
                    this.swayOffset += this.swaySpeed;
                    this.angle += this.spin;

                    if (this.isBurst) {
                        this.vy += 0.06; // Hafif yerçekimi
                        this.life -= 0.012;
                    } else if (this.y > height + 20) {
                        this.reset(false);
                        this.y = -15;
                    }
                }

                draw() {
                    ctx.save();
                    ctx.globalAlpha = Math.max(0, this.life);
                    ctx.translate(this.x, this.y);
                    ctx.rotate(this.angle);

                    if (this.isSparkle) {
                        // Parıltı noktası
                        ctx.beginPath();
                        ctx.arc(0, 0, this.size, 0, Math.PI * 2);
                        ctx.fillStyle = this.color;
                        ctx.shadowBlur = 8;
                        ctx.shadowColor = '#fda4af';
                        ctx.fill();
                    } else {
                        // Organik çiçek taç yaprağı şekli
                        ctx.beginPath();
                        ctx.moveTo(0, -this.size);
                        ctx.bezierCurveTo(this.size, -this.size / 2, this.size, this.size / 2, 0, this.size);
                        ctx.bezierCurveTo(-this.size, this.size / 2, -this.size, -this.size / 2, 0, -this.size);
                        ctx.fillStyle = this.color;
                        ctx.fill();
                    }
                    ctx.restore();
                }
            }

            // Başlangıçta ekranda nazikçe süzülen yaprakları oluştur
            const initialCount = window.innerWidth < 640 ? 28 : 45;
            for (let i = 0; i < initialCount; i++) {
                const p = new Particle(false);
                p.y = Math.random() * height; // İlk açılışta ekranın her yerinde olsun
                particles.push(p);
            }

            // Mektup açıldığında ekstra yaprak saçılması
            function burstPetals() {
                for (let i = 0; i < 30; i++) {
                    particles.push(new Particle(true));
                }
            }

            // Animasyon Döngüsü
            function animate() {
                ctx.clearRect(0, 0, width, height);
                for (let i = particles.length - 1; i >= 0; i--) {
                    const p = particles[i];
                    p.update();
                    p.draw();
                    if (p.isBurst && p.life <= 0) {
                        particles.splice(i, 1);
                    }
                }
                requestAnimationFrame(animate);
            }

            animate();
        });
    </script>
</body>
</html>
