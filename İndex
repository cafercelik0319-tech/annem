<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>İyi Ki Doğdun Canım Annem</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Zarif el yazısı ve okunaklı serif fontlar -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Great+Vibes&family=Montserrat:wght@300;400;500&display=swap" rel="stylesheet">
    
    <style>
        /* Özel Font Tanımları */
        .font-script { font-family: 'Great Vibes', cursive; }
        .font-serif-elegant { font-family: 'Cormorant Garamond', serif; }
        .font-sans-clean { font-family: 'Montserrat', sans-serif; }

        /* Arka Plan Yumuşak Pastel Geçişi */
        body {
            background: radial-gradient(circle at 50% 40%, #fff5f7 0%, #fce7eb 45%, #f5d0d8 100%);
            overflow-x: hidden;
            min-height: 100vh;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        /* Buket Hafif Salınım Animasyonu */
        @keyframes gentleSway {
            0%, 100% { transform: rotate(-1.5deg) translateY(0px); }
            50% { transform: rotate(1.5deg) translateY(-5px); }
        }
        .bouquet-sway {
            transform-origin: bottom center;
            animation: gentleSway 6s ease-in-out infinite;
        }

        /* Çiçeklerin Hafif Nefes Alma Efekti */
        @keyframes flowerBreathe {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.03); }
        }
        .flower-pulse {
            transform-origin: center;
            animation: flowerBreathe 4s ease-in-out infinite;
        }

        /* Zarf Dikkat Çekici Nabız Animasyonu */
        @keyframes envelopeFloat {
            0%, 100% { transform: translateY(0px) rotate(-3deg) scale(1); }
            50% { transform: translateY(-6px) rotate(-1deg) scale(1.04); }
        }
        .envelope-interactive {
            animation: envelopeFloat 3s ease-in-out infinite;
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            cursor: pointer;
        }
        .envelope-interactive:hover {
            animation-play-state: paused;
            transform: scale(1.1) rotate(0deg) !important;
            filter: drop-shadow(0 12px 20px rgba(225, 29, 72, 0.35));
        }
        .envelope-interactive:active {
            transform: scale(0.95) !important;
        }

        /* Zarf Kapağı Açılma Animasyonu */
        .flap {
            transform-origin: top center;
            transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .envelope-opened .flap {
            transform: rotateX(180deg);
        }

        /* Mektup Kağıdı Dokusu ve Gölgeleri */
        .letter-paper {
            background-color: #fffdf9;
            background-image: 
                radial-gradient(#e5d5c5 0.5px, transparent 0.5px),
                linear-gradient(to bottom, rgba(255,255,255,0.8), rgba(252,244,236,0.9));
            background-size: 20px 20px, 100% 100%;
            box-shadow: 
                0 25px 50px -12px rgba(136, 19, 55, 0.25),
                0 0 0 1px rgba(244, 63, 94, 0.15),
                inset 0 0 40px rgba(251, 207, 232, 0.3);
        }

        /* Modal Açılış Kapanış Geçişleri */
        .modal-backdrop {
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.5s ease;
        }
        .modal-backdrop.active {
            opacity: 1;
            pointer-events: auto;
        }
        .modal-card {
            transform: translateY(40px) scale(0.9);
            opacity: 0;
            transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .modal-backdrop.active .modal-card {
            transform: translateY(0) scale(1);
            opacity: 1;
        }

        /* İnce Kaydırma Çubuğu (Uzun ekranlarda veya küçük telefonlarda mektup için) */
        .custom-scroll::-webkit-scrollbar {
            width: 5px;
        }
        .custom-scroll::-webkit-scrollbar-track {
            background: rgba(254, 205, 211, 0.2);
            border-radius: 10px;
        }
        .custom-scroll::-webkit-scrollbar-thumb {
            background: rgba(244, 63, 94, 0.3);
            border-radius: 10px;
        }
    </style>
</head>
<body class="relative flex flex-col items-center justify-between min-h-screen py-6 px-4 font-sans-clean text-rose-950">

